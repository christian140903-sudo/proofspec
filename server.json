{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.christian140903-sudo/proofspec",
  "description": "Executable evidence contracts and CI gates for public software claims.",
  "repository": {
    "url": "https://github.com/christian140903-sudo/proofspec",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "proofspec",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "runtimeHint": "npx",
      "runtimeArguments": ["-y"],
      "packageArguments": ["serve"],
      "environmentVariables": [
        {
          "name": "PROOFSPEC_CONFIG",
          "description": "Optional path to the default proofspec.json file.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
